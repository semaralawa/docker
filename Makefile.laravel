# =============================================================================
# Makefile for Laravel Docker Environment
# =============================================================================

.PHONY: help dev-up dev-down prod-up prod-down build-dev build-prod \
	shell composer artisan migrate logs clean

# Default environment
ENV ?= dev
COMPOSE_FILE_DEV := docker-compose.laravel.dev.yml
COMPOSE_FILE_PROD := docker-compose.laravel.prod.yml

# Colors for output
BLUE := \033[0;34m
GREEN := \033[0;32m
YELLOW := \033[0;33m
NC := \033[0m # No Color

help:
	@echo "$(BLUE)Laravel Docker Environment Commands$(NC)"
	@echo ""
	@echo "$(GREEN)Development:$(NC)"
	@echo "  make dev-up          Start development environment"
	@echo "  make dev-down        Stop development environment"
	@echo "  make build-dev       Build development images"
	@echo ""
	@echo "$(GREEN)Production:$(NC)"
	@echo "  make prod-up         Start production environment"
	@echo "  make prod-down       Stop production environment"
	@echo "  make build-prod      Build production images"
	@echo ""
	@echo "$(GREEN)Application:$(NC)"
	@echo "  make shell           Open shell in app container"
	@echo "  make composer CMD=   Run composer command"
	@echo "  make artisan CMD=    Run artisan command"
	@echo "  make migrate         Run database migrations"
	@echo "  make test            Run tests"
	@echo ""
	@echo "$(GREEN)Utilities:$(NC)"
	@echo "  make logs SERVICE=   View logs (default: all)"
	@echo "  make clean           Remove all containers, volumes, and images"
	@echo "  make restart         Restart all services"

# Development Commands
dev-up:
	@echo "$(GREEN)Starting Laravel development environment...$(NC)"
	@docker compose -f $(COMPOSE_FILE_DEV) up -d
	@echo "$(GREEN)✓ Development environment is running$(NC)"
	@echo "$(BLUE)Access your application at: http://localhost:8080$(NC)"

dev-down:
	@echo "$(YELLOW)Stopping development environment...$(NC)"
	@docker compose -f $(COMPOSE_FILE_DEV) down

build-dev:
	@echo "$(GREEN)Building development images...$(NC)"
	@docker compose -f $(COMPOSE_FILE_DEV) build --pull

# Production Commands
prod-up:
	@echo "$(GREEN)Starting Laravel production environment...$(NC)"
	@docker compose -f $(COMPOSE_FILE_PROD) up -d
	@echo "$(GREEN)✓ Production environment is running$(NC)"

prod-down:
	@echo "$(YELLOW)Stopping production environment...$(NC)"
	@docker compose -f $(COMPOSE_FILE_PROD) down

build-prod:
	@echo "$(GREEN)Building production images...$(NC)"
	@docker compose -f $(COMPOSE_FILE_PROD) build --pull --no-cache

# Application Commands
shell:
	@docker compose -f $(COMPOSE_FILE_DEV) exec app bash

composer:
ifndef CMD
	@echo "$(YELLOW)Usage: make composer CMD='install'$(NC)"
	@exit 1
endif
	@docker compose -f $(COMPOSE_FILE_DEV) exec app composer $(CMD)

artisan:
ifndef CMD
	@docker compose -f $(COMPOSE_FILE_DEV) exec app php artisan list
else
	@docker compose -f $(COMPOSE_FILE_DEV) exec app php artisan $(CMD)
endif

migrate:
	@echo "$(GREEN)Running migrations...$(NC)"
	@docker compose -f $(COMPOSE_FILE_DEV) exec app php artisan migrate --force

test:
	@echo "$(GREEN)Running tests...$(NC)"
	@docker compose -f $(COMPOSE_FILE_DEV) exec app php artisan test

# Utility Commands
logs:
ifdef SERVICE
	@docker compose -f $(COMPOSE_FILE_DEV) logs -f --tail=100 $(SERVICE)
else
	@docker compose -f $(COMPOSE_FILE_DEV) logs -f --tail=100
endif

restart:
	@echo "$(YELLOW)Restarting services...$(NC)"
	@docker compose -f $(COMPOSE_FILE_DEV) restart

clean:
	@echo "$(YELLOW)⚠️  This will remove all containers, volumes, and images!$(NC)"
	@read -p "Are you sure? [y/N] " -n 1 -r; \
	echo; \
	if [[ $$REPLY =~ ^[Yy]$$ ]]; then \
		docker compose -f $(COMPOSE_FILE_DEV) down -v --rmi all; \
		docker compose -f $(COMPOSE_FILE_PROD) down -v --rmi all; \
		echo "$(GREEN)✓ Cleanup complete$(NC)"; \
	fi

# Database Commands
db-shell:
	@docker compose -f $(COMPOSE_FILE_DEV) exec db mysql -u$${DB_USERNAME:-laravel} -p$${DB_PASSWORD:-secret} $${DB_DATABASE:-laravel}

db-dump:
	@echo "$(GREEN)Creating database dump...$(NC)"
	@docker compose -f $(COMPOSE_FILE_DEV) exec db mysqldump -u$${DB_USERNAME:-laravel} -p$${DB_PASSWORD:-secret} $${DB_DATABASE:-laravel} > backup_$$(date +%Y%m%d_%H%M%S).sql
	@echo "$(GREEN)✓ Database dump created$(NC)"
