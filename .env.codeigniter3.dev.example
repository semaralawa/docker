# =============================================================================
# Environment Configuration for CodeIgniter 3 Development
# Copy this file to .env and update with your values
# =============================================================================

# Application
APP_NAME=ci3
PHP_VERSION=7.4
LOCAL_UID=1000
LOCAL_GID=1000

# Ports
APP_PORT=8080
DB_PORT=3306
REDIS_PORT=6379
MAILHOG_PORT=8025
MAILHOG_SMTP_PORT=1025

# Database
DB_DATABASE=ci3_db
DB_USERNAME=ci3_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Redis
REDIS_PASSWORD=redissecret
