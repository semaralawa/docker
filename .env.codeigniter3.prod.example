# =============================================================================
# Environment Configuration for CodeIgniter 3 Production
# IMPORTANT: Use strong passwords and keep this file secure!
# =============================================================================

# Application
APP_NAME=ci3
PHP_VERSION=7.4
LOCAL_UID=1000
LOCAL_GID=1000

# Ports
APP_PORT=80

# Database - USE STRONG PASSWORDS IN PRODUCTION
DB_DATABASE=ci3_prod
DB_USERNAME=ci3_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD_HERE

# Redis - USE STRONG PASSWORD IN PRODUCTION
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_HERE
