# =============================================================================
# Environment Configuration for Laravel Development
# Copy this file to .env and update with your values
# =============================================================================

# Application
APP_NAME=laravel
PHP_VERSION=8.2
LOCAL_UID=1000
LOCAL_GID=1000

# Ports
APP_PORT=8080
DB_PORT=3306
REDIS_PORT=6379
MAILHOG_PORT=8025
MAILHOG_SMTP_PORT=1025

# Database
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Redis
REDIS_PASSWORD=redissecret
